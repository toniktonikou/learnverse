		event:FireServer("ANSWER", i)

		-- Prevent double clicking
		for _, b in ipairs(buttons) do
			b.Active = false
		end
	end)
end

local running = false

local function enableButtons()
	for _, b in ipairs(buttons) do
		b.Active = true
	end
end

local function showMessage(text)
	question.Text = text

	for _, b in ipairs(buttons) do
		b.Visible = false
	end

	timer.Visible = false
	numberLabel.Visible = false
end

event.OnClientEvent:Connect(function(action, ...)
	local args = {...}

	if action == "QUESTION" then
		local q = args[1]
		local answers = args[2]
		local timeLimit = args[3]
		local score = args[4]
		local lives = args[5]
		local questionNumber = args[6]

		question.Text = q
		scoreLabel.Text = "Score: " .. score

		local hearts = ""
		for i = 1, 3 do
			if i <= lives then
				hearts ..= "❤️"
			else
				hearts ..= "🖤"
			end
		end

		livesLabel.Text = hearts
		numberLabel.Text = "Question " .. questionNumber .. " / 10"

		timer.Visible = true
		numberLabel.Visible = true

		for i = 1, 4 do
			buttons[i].Visible = true
			buttons[i].Text = answers[i].text
			buttons[i].Active = true
		end

		running = true

		for t = timeLimit, 0, -1 do
			if not running then
				break
			end

			timer.Text = "⏱ " .. t

			task.wait(1)
		end

	elseif action == "CORRECT" then
		running = false
		scoreLabel.Text = "Score: " .. args[1]
		question.Text = "✅ CORRECT!"

	elseif action == "WRONG" then
		running = false
		question.Text = "❌ WRONG!"
		livesLabel.Text = string.rep("❤️", math.max(0, args[2])) ..
			string.rep("🖤", 3 - math.max(0, args[2]))

	elseif action == "GAMEOVER" then
		running = false
		showMessage(
			"💥 GAME OVER!\n\nFinal Score: " .. args[1] ..
			"\n\nRejoin to play again!"
		)

	elseif action == "FINISH" then
		running = false
		showMessage(
			"🏆 YOU FINISHED!\n\nScore: " .. args[1] ..
			"\n\nRejoin to play again!"
		)
	end
end)

