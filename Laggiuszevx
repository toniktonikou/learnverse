-- QUICK THINK! - Fast Logic Game
-- Put this Script inside ServerScriptService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- RemoteEvent for sending questions to each player
local event = Instance.new("RemoteEvent")
event.Name = "QuickThinkEvent"
event.Parent = ReplicatedStorage

local questions = {
	{
		q = "2, 4, 8, 16, ?",
		a = {"24", "32", "30", "20"},
		c = 2
	},
	{
		q = "Which one doesn't belong?",
		a = {"🍎", "🍌", "🍊", "🚗"},
		c = 4
	},
	{
		q = "If A = 1, B = 2, C = 3, what is CAB?",
		a = {"123", "213", "312", "321"},
		c = 3
	},
	{
		q = "🔺 🔻 🔺 🔻 ?",
		a = {"🔻", "⬛", "🔺", "⚪"},
		c = 3
	},
	{
		q = "5 + 3 × 2 = ?",
		a = {"16", "11", "13", "10"},
		c = 2
	},
	{
		q = "What comes next? 1, 1, 2, 3, 5, ?",
		a = {"6", "7", "8", "9"},
		c = 3
	},
	{
		q = "Which number is different?",
		a = {"2", "4", "6", "9"},
		c = 4
	},
	{
		q = "If you have 3 apples and get 4 more, how many?",
		a = {"6", "7", "8", "9"},
		c = 2
	},
	{
		q = "🐶 = 4 legs. 🐱 = 4 legs. 🐔 = 2 legs. Which has the fewest?",
		a = {"🐶", "🐱", "🐔", "All equal"},
		c = 3
	},
	{
		q = "10, 20, 30, 40, ?",
		a = {"45", "50", "60", "55"},
		c = 2
	}
}

local playerData = {}

local function sendQuestion(player)
	local data = playerData[player]
	if not data then return end

	data.questionNumber += 1

	-- Finish after 10 questions
	if data.questionNumber > 10 then
		event:FireClient(player, "FINISH", data.score)
		return
	end

	local question = questions[math.random(1, #questions)]

	-- Make a copy so the answer order can be randomized
	local answers = {}
	for i, answer in ipairs(question.a) do
		answers[i] = {
			text = answer,
			correct = (i == question.c)
		}
	end

	-- Shuffle answers
	for i = #answers, 2, -1 do
		local j = math.random(i)
		answers[i], answers[j] = answers[j], answers[i]
	end

	local correctIndex

	for i, answer in ipairs(answers) do
		if answer.correct then
			correctIndex = i
		end
	end

	data.currentCorrect = correctIndex

	-- Faster timer as the player progresses
	data.timeLimit = math.max(3, 10 - math.floor((data.questionNumber - 1) / 3))

	event:FireClient(
		player,
		"QUESTION",
		question.q,
		answers,
		data.timeLimit,
		data.score,
		data.lives,
		data.questionNumber
	)

	-- Timer
	local thisQuestion = data.questionNumber

	task.delay(data.timeLimit, function()
		if playerData[player] and playerData[player].questionNumber == thisQuestion then
			data.lives -= 1

			if data.lives <= 0 then
				event:FireClient(player, "GAMEOVER", data.score)
			else
				sendQuestion(player)
			end
		end
	end)
end

event.OnServerEvent:Connect(function(player, action, answerNumber)
	local data = playerData[player]

	if not data or action ~= "ANSWER" then
		return
	end

	if data.locked then
		return
	end

	data.locked = true

	if answerNumber == data.currentCorrect then
		data.score += 100
		event:FireClient(player, "CORRECT", data.score)

		task.wait(0.5)

		if playerData[player] then
			data.locked = false
			sendQuestion(player)
		end
	else
		data.lives -= 1

		event:FireClient(player, "WRONG", data.score, data.lives)

		task.wait(0.5)

		if data.lives <= 0 then
			event:FireClient(player, "GAMEOVER", data.score)
		else
			data.locked = false
			sendQuestion(player)
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	playerData[player] = {
		score = 0,
		lives = 3,
		questionNumber = 0,
		currentCorrect = nil,
		locked = false,
		timeLimit = 10
	}

	-- Leaderboard
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local score = Instance.new("IntValue")
	score.Name = "Score"
	score.Value = 0
	score.Parent = leaderstats

	task.wait(2)
	sendQuestion(player)
end)
